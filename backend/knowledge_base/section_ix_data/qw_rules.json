      { "min_mm": 10, "max_mm": 19, "max_inclusive": false, "visual": true, "side_bend": 2, "face_bend": 0, "root_bend": 0, "substitution_note": "One face and one root bend may be substituted for the two side bends.", "verified": false, "verified_by": null, "verified_date": null },
