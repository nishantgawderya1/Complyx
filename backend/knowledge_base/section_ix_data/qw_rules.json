  "qw_452_1a": {
    "clause_ref": "QW-452.1(a)",
    "title": "Test specimens required by weld metal thickness",
    "source_page": 239,
    "note": "Thickness of weld metal is the total deposited by all welders and all processes in the coupon, excluding reinforcement. Note (1): positions 5G or 6G require four bend specimens; a 2G+5G combination requires six. Note (3): one face and one root bend may be substituted for the two side bends.",
