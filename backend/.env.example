# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_ENV=development
SECRET_KEY=

# Observability (leave blank in local dev)
SENTRY_DSN=

# PDF parsing tuning
# Absolute path to the tesseract binary. Leave blank to use the system PATH.
TESSERACT_CMD=
